{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/tw-agri-copilot/schema/county-registry.schema.json",
  "title": "Taiwan Produce Watch county registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "geometry_source", "counties"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "geometry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_url", "source_hash", "geometry_version", "converter_version"],
      "properties": {
        "dataset_url": {"const": "https://data.gov.tw/dataset/7442"},
        "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "geometry_version": {"type": "string", "minLength": 1},
        "converter_version": {"type": "string", "minLength": 1}
      }
    },
    "counties": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["county_code", "slug", "display_name", "source_names", "svg_path_id"],
        "properties": {
          "county_code": {"type": "string", "pattern": "^[0-9]{5}$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "display_name": {"type": "string", "minLength": 1},
          "source_names": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "svg_path_id": {"type": "string", "pattern": "^county-shape-[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    }
  }
}
