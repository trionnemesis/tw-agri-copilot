{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/tw-agri-copilot/schema/market-calendar.schema.json",
  "title": "Taiwan Produce Watch normalized market calendar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_role",
    "document_url",
    "calendar_year",
    "calendar_version",
    "retrieved_at",
    "content_hash",
    "parser_version",
    "market_codes",
    "closed_day_count",
    "trading_day_count",
    "entries"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"type": "string", "minLength": 1},
    "source_role": {"const": "calendar"},
    "document_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "calendar_year": {"type": "integer", "minimum": 2000, "maximum": 2200},
    "calendar_version": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parser_version": {"type": "string", "minLength": 1},
    "market_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["market_code", "market_name"],
        "properties": {
          "market_code": {"type": "string", "minLength": 1},
          "market_name": {"type": "string", "minLength": 1}
        }
      }
    },
    "closed_day_count": {"type": "integer", "minimum": 0},
    "trading_day_count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "minItems": 365,
      "maxItems": 366,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["calendar_date", "schedule_status", "reason"],
        "properties": {
          "calendar_date": {"type": "string", "format": "date"},
          "schedule_status": {
            "enum": ["expected_open", "scheduled_closed", "exceptional_open"]
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
