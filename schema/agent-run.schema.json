{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trionnemesis/tw-agri-copilot/schema/agent-run.schema.json",
  "title": "Agent Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "trigger", "requested_at", "as_of_date",
    "operation", "source_refs", "model", "prompt_version", "input_hash",
    "fields_changed", "analysis", "assumptions", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "trigger": {"enum": ["schedule", "manual", "agent-request"]},
    "requested_at": {"type": "string", "format": "date-time"},
    "as_of_date": {"type": "string", "format": "date"},
    "operation": {"enum": ["upsert-data", "add-analysis", "refresh-fields"]},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fields_changed": {"type": "array", "items": {"type": "string"}},
    "analysis": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "status": {"const": "proposed"}
  }
}
