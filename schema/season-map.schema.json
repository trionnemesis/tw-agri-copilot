{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/tw-agri-copilot/schema/season-map.schema.json",
  "title": "Taiwan Produce Watch current county season map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of_month", "resolved_market_date", "inputs", "unmapped_source_counties", "categories", "counties"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "as_of_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "resolved_market_date": {"type": "string", "format": "date"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seasonality_sources", "seasonality_snapshot_hash", "county_registry_hash", "market_registry_hash", "geometry_hash", "category_registry_hash"],
      "properties": {
        "seasonality_sources": {
          "description": "Keyed by category id; only categories with at least one catalog row this month appear here (see the categories array's catalog_row_count). A no_official_season_registry category (config/produce-categories.json) never appears.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_status"],
            "properties": {
              "source_status": {"enum": ["live", "stale", "fallback"]}
            }
          }
        },
        "seasonality_snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "county_registry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "market_registry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "geometry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "category_registry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "unmapped_source_counties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "categories": {
      "description": "Every registered produce category (config/produce-categories.json), in registry order. A no_official_season_registry category (Issue #44 BC-2 / BC-3, SPEC.md section 6.2.6) always has catalog_row_count 0 and never has rows under counties[*].local_seasonal_produce -- its map cells are unknown, not populated.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "season_semantics", "catalog_row_count"],
        "properties": {
          "id": {"enum": ["fruit", "vegetable", "livestock", "aquaculture"]},
          "label": {"type": "string", "minLength": 1},
          "season_semantics": {"enum": ["official_season_registry", "no_official_season_registry"]},
          "catalog_row_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "counties": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["county_code", "slug", "display_name", "seasonal_catalog_count", "local_seasonal_produce", "official_markets"],
        "properties": {
          "county_code": {"type": "string", "pattern": "^[0-9]{5}$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "display_name": {"type": "string", "minLength": 1},
          "seasonal_catalog_count": {"type": "integer", "minimum": 0},
          "local_seasonal_produce": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "display_name", "canonical_id", "source_status"],
              "properties": {
                "category": {"enum": ["fruit", "vegetable", "livestock", "aquaculture"]},
                "display_name": {"type": "string", "minLength": 1},
                "canonical_id": {"type": ["string", "null"], "minLength": 1},
                "source_status": {"enum": ["live", "stale", "fallback"]}
              }
            }
          },
          "official_markets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["market_code", "feed_market_name", "official_name", "official_url", "evidence_url", "feed_coverage_status"],
              "properties": {
                "market_code": {"type": "string", "pattern": "^[0-9]{3}$"},
                "feed_market_name": {"type": "string", "minLength": 1},
                "official_name": {"type": "string", "minLength": 1},
                "official_url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://"},
                "feed_coverage_status": {"enum": ["observed", "not_observed", "unknown"]}
              }
            }
          }
        }
      }
    }
  }
}
