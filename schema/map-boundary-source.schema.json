{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trionnemesis.github.io/tw-agri-copilot/schema/map-boundary-source.schema.json",
  "title": "Taiwan Produce Watch county boundary lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "dataset_title", "provider", "dataset_url", "resource_url", "license_name", "license_url", "source_archive_name", "source_format", "source_crs", "geometry_version", "source_time_position_roc", "source_time_indeterminate_position", "downloaded_on", "source_hash", "converter_version", "converted_on", "conversion", "asset_path", "geometry_hash", "county_codes", "attribution"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_id": {"const": "nlsc_county_boundary_7442"},
    "dataset_title": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "dataset_url": {"const": "https://data.gov.tw/dataset/7442"},
    "resource_url": {"type": "string", "format": "uri", "pattern": "^https://www\\.tgos\\.tw/"},
    "license_name": {"type": "string", "minLength": 1},
    "license_url": {"const": "https://data.gov.tw/license"},
    "source_archive_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.zip$"},
    "source_format": {"const": "GML"},
    "source_crs": {"const": "EPSG:3824"},
    "geometry_version": {"type": "string", "minLength": 1},
    "source_time_position_roc": {"type": "string", "pattern": "^[0-9]{3}-[0-9]{2}-[0-9]{2}$"},
    "source_time_indeterminate_position": {"const": "after"},
    "downloaded_on": {"type": "string", "format": "date"},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "converter_version": {"type": "string", "minLength": 1},
    "converted_on": {"type": "string", "format": "date"},
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view_box", "simplification_method", "simplification_tolerance_pixels", "minimum_ring_area_pixels", "maximum_rings_per_county", "mainland_filter_bbox", "offshore_inset_county_codes"],
      "properties": {
        "view_box": {"const": "0 0 720 900"},
        "simplification_method": {"const": "Ramer-Douglas-Peucker"},
        "simplification_tolerance_pixels": {"type": "number", "exclusiveMinimum": 0},
        "minimum_ring_area_pixels": {"type": "number", "exclusiveMinimum": 0},
        "maximum_rings_per_county": {"type": "integer", "minimum": 1},
        "mainland_filter_bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "offshore_inset_county_codes": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{5}$"}}
      }
    },
    "asset_path": {"const": "src/tpw/assets/taiwan-counties.svg"},
    "geometry_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "county_codes": {"type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{5}$"}},
    "attribution": {"type": "string", "minLength": 1}
  }
}
